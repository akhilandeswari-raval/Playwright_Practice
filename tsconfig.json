{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "@playwright@latest"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "plugins": [
      {
        "name": "tslint-language-service"
      }
    ],
  },
  "include": [
    "src",
    "tests",
    "page-objects/pageNavigation.ts"
  ]
}